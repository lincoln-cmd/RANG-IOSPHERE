---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="신호를 찾을 수 없습니다 | 랑이오스페어" description="요청한 페이지를 찾을 수 없습니다" socialImage={null}>
  <SiteHeader compact />
  <main id="main-content" class="not-found" tabindex="-1">
    <div class="lost-signal" aria-hidden="true"><span></span><i></i></div>
    <div class="not-found-copy">
      <p class="eyebrow">ERROR 404 · SIGNAL LOST</p>
      <h1>관측 범위를<br />벗어났습니다.</h1>
      <p>요청한 기록을 찾을 수 없습니다. 주소가 변경되었거나 아직 공개되지 않은 기록일 수 있습니다.</p>
      <div><a href="/">관측소로 돌아가기 ↙</a><a href="/archive/">아카이브 보기 ↗</a></div>
    </div>
    <dl><div><dt>REQUEST</dt><dd>NOT FOUND</dd></div><div><dt>STATUS</dt><dd>404</dd></div><div><dt>NEXT</dt><dd>RETURN HOME</dd></div></dl>
  </main>
  <SiteFooter />
</BaseLayout>
