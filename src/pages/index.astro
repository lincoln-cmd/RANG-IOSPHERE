---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getCollection } from 'astro:content';
import { byPublishedDate } from '../lib/content';

const posts = (await getCollection('posts', ({ data }) => !data.draft && Boolean(data.publishedAt))).sort(byPublishedDate);
const highlightedPost = posts.find((post) => post.data.featured) ?? posts[0];
const siteURL = Astro.site ?? Astro.url;
const homeStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '랑이오스페어',
  alternateName: 'RANG-IOSPHERE',
  url: new URL('/', siteURL).href,
  description: '관측하고, 비교하고, 기록하는 개인 천체관측 아카이브',
  inLanguage: 'ko-KR',
  creator: {
    '@type': 'Person',
    name: '김동훈',
  },
};

const sectors = [
  { id: 'log', category: 'observation', index: '01', label: '관측일지', en: 'Observation Log', x: 23, y: 36, note: '밤하늘에서 직접 얻은 기록' },
  { id: 'gear', category: 'equipment', index: '02', label: '장비와 사용법', en: 'Equipment', x: 42, y: 23, note: '망원경의 구조와 운용' },
  { id: 'theory', category: 'theory', index: '03', label: '관측 이론', en: 'Field Theory', x: 58, y: 43, note: '관측을 이해하는 데 필요한 이론' },
  { id: 'simulation', category: 'simulation', index: '04', label: '시뮬레이션', en: 'Simulation', x: 72, y: 27, note: '예측값과 실제 관측의 비교' },
  { id: 'data', category: 'open-data', index: '05', label: '오픈데이터', en: 'Open Data', x: 80, y: 61, note: '공개 천문 데이터 탐구' },
];
---

<BaseLayout structuredData={homeStructuredData}>
  <main>
    <SiteHeader />

    <section class="hero" id="observatory">
      <div class="hero-copy">
        <p class="eyebrow">A PERSONAL NIGHT-SKY ARCHIVE · WITH RANG</p>
        <h1>랑이와 함께 보는<br /><em>밤하늘 기록.</em></h1>
        <p class="intro">직접 수행한 천체 관측을 바탕으로 관측 조건과 장비 운용을 기록하고, 관련 이론·시뮬레이션·공개 데이터를 함께 비교하며 탐구의 과정을 차곡차곡 쌓아가는 개인 아카이브입니다.</p>
        <a class="primary-action" href="#archive">기록 둘러보기 <span>↘</span></a>
      </div>

      <div class="sky-map" aria-label="랑이오스페어 관측 영역 지도">
        <div class="orbit orbit-a"></div><div class="orbit orbit-b"></div>
        <svg class="connections" viewBox="0 0 100 80" preserveAspectRatio="none" aria-hidden="true">
          <path d="M23 36 L42 23 L58 43 L72 27 L80 61" />
        </svg>
        {sectors.map((sector) => (
          <a class="star-node" href={`#${sector.id}`} style={`--x:${sector.x}%;--y:${sector.y}%`} aria-label={`${sector.label}: ${sector.note}`}>
            <span class="star"></span><span class="star-label">{sector.index} · {sector.label}</span>
          </a>
        ))}
        <div class="coordinate top-left">AZ 000°</div><div class="coordinate bottom-right">ALT +37°</div>
        <div class="reticle"><span></span></div>
      </div>
      <p class="scroll-cue">SCROLL TO EXPLORE <span>↓</span></p>
    </section>

    <section class="archive" id="archive">
      <div class="section-heading">
        <p class="eyebrow">OBSERVATION SECTORS</p>
        <h2>다섯 개의 관측 영역</h2>
        <p>별을 선택하듯 기록과 탐구 사이를 이동합니다.</p>
      </div>
      <div class="sector-grid">
        {sectors.map((sector) => (
          <article class="sector-card" id={sector.id}>
            <div><span>{sector.index}</span><small>{sector.en} · {String(posts.filter((post) => post.data.category === sector.category).length).padStart(2, '0')}</small></div>
            <h3>{sector.label}</h3>
            <p>{sector.note}</p>
            <a href={`/archive/#${sector.category}`} aria-label={`${sector.label} 아카이브 보기`}>OPEN ARCHIVE <span>↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class:list={["first-record", { "has-record-cover": Boolean(highlightedPost?.data.cover) }]} id="featured-record">
      {highlightedPost ? (
        <>
          <div>
            <p class="eyebrow">{highlightedPost.data.featured ? 'FEATURED FIELD NOTE' : 'LATEST FIELD NOTE'}</p>
            <h2><a href={`/archive/${highlightedPost.id}/`}>{highlightedPost.data.title}</a></h2>
            <a class="first-record-link" href={`/archive/${highlightedPost.id}/`}>기록 읽기 <span>↗</span></a>
          </div>
          <p>{highlightedPost.data.description}</p>
          <div class="first-record-visual">
            {highlightedPost.data.cover && <img src={highlightedPost.data.cover} alt="" loading="lazy" decoding="async" />}
            <span class="record-number">{String(posts.length - posts.indexOf(highlightedPost)).padStart(4, '0')}</span>
          </div>
        </>
      ) : (
        <>
          <div><p class="eyebrow">FIRST FIELD NOTE · PREPARING</p><h2>첫 번째 기록을<br />준비하고 있습니다.</h2></div>
          <p>직접 관측하고 공부한 내용을 확인한 뒤 이곳에 첫 기록을 공개할 예정입니다.</p>
          <span class="record-number">0000</span>
        </>
      )}
    </section>

    <SiteFooter />
  </main>
</BaseLayout>
