---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { formatDate, hasObservationData } from '../lib/content';
import '../styles/observations.css';
import '../styles/observations-export.css';
import '../styles/observations-mobile.css';

const records = (await getCollection('posts', ({ data }) => !data.draft && Boolean(data.publishedAt) && hasObservationData(data.observation)))
  .sort((a, b) => (b.data.observation?.observedAt?.getTime() ?? b.data.publishedAt?.getTime() ?? 0) - (a.data.observation?.observedAt?.getTime() ?? a.data.publishedAt?.getTime() ?? 0));
const targets = new Set(records.flatMap((post) => post.data.observation?.target ? [post.data.observation.target] : []));
const equipment = new Set(records.flatMap((post) => post.data.observation?.equipment ?? []));
const latestObservation = records.find((post) => post.data.observation?.observedAt)?.data.observation?.observedAt;
const datasetStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: '랑이오스페어 공개 관측 데이터',
  description: '직접 수행한 천체 관측 기록에서 공개한 관측 대상, 장비 및 환경 수치',
  url: new URL('/observations/', Astro.site ?? Astro.url).href,
  creator: { '@type': 'Person', name: '김동훈' },
  inLanguage: 'ko-KR',
  isAccessibleForFree: true,
  temporalCoverage: records.length ? `${records.at(-1)?.data.observation?.observedAt?.toISOString() ?? ''}/${latestObservation?.toISOString() ?? ''}` : undefined,
  variableMeasured: ['관측 대상', '사용 장비', '시상', '투명도', '기온', '습도'],
  distribution: {
    '@type': 'DataDownload',
    encodingFormat: 'text/csv',
    contentUrl: new URL('/observations/data.csv', Astro.site ?? Astro.url).href,
  },
};
---
<BaseLayout title="관측 데이터 현황 | 랑이오스페어" description="랑이오스페어에 공개된 천체 관측 대상, 장비와 환경 수치를 한눈에 확인합니다" structuredData={datasetStructuredData}>
  <SiteHeader compact />
  <main id="main-content" class="observations-page" tabindex="-1">
    <header class="observations-hero">
      <p class="eyebrow">OBSERVATION DATASET · PUBLIC RECORDS</p>
      <h1>관측 데이터 현황</h1>
      <p>공개한 관측일지에서 관측 대상과 장비, 환경 수치를 모아 봅니다. 장소와 정확한 관측 시각은 이 요약 데이터에서 제외합니다.</p>
      <dl>
        <div><dt>RECORDS</dt><dd>{String(records.length).padStart(2, '0')}</dd></div>
        <div><dt>TARGETS</dt><dd>{String(targets.size).padStart(2, '0')}</dd></div>
        <div><dt>EQUIPMENT</dt><dd>{String(equipment.size).padStart(2, '0')}</dd></div>
        <div><dt>LATEST</dt><dd>{latestObservation ? formatDate(latestObservation) : '—'}</dd></div>
      </dl>
    </header>

    <section class="observations-ledger" aria-labelledby="ledger-title">
      <div class="observations-heading">
        <div><p class="eyebrow">FIELD DATA LEDGER</p><h2 id="ledger-title">공개 관측 기록</h2></div>
        <div class="observations-heading-summary">
          <p>각 기록의 원문과 개별 JSON을 확인하거나, 공개된 관측값 전체를 CSV로 내려받을 수 있습니다.</p>
          {records.length > 0 && <a class="dataset-download" href="/observations/data.csv" download>전체 데이터 CSV <span aria-hidden="true">↓</span></a>}
        </div>
      </div>
      {records.length ? (
        <>
        <div class="observations-tools" aria-label="관측 기록 검색과 정렬">
          <label class="observations-search" for="observation-search">
            <span>SEARCH RECORDS</span>
            <input id="observation-search" type="search" placeholder="대상·제목·장비 검색" autocomplete="off" />
          </label>
          <label class="observations-sort" for="observation-sort">
            <span>SORT BY</span>
            <select id="observation-sort">
              <option value="newest">최신 관측순</option>
              <option value="oldest">오래된 관측순</option>
              <option value="target">대상 이름순</option>
            </select>
          </label>
          <p class="observations-result" aria-live="polite"><strong>{records.length}</strong>개 기록</p>
          <button class="observations-reset" type="button" hidden>초기화</button>
        </div>
        <div class="observations-table-wrap">
          <table>
            <thead><tr><th>관측일</th><th>대상</th><th>장비</th><th>시상 / 투명도</th><th>기온 / 습도</th><th><span class="sr-only">기록 이동</span></th></tr></thead>
            <tbody>
              {records.map((post) => {
                const observation = post.data.observation!;
                const sortDate = observation.observedAt ?? post.data.publishedAt;
                const searchText = [observation.target, post.data.title, ...observation.equipment].filter(Boolean).join(' ').toLocaleLowerCase('ko-KR');
                return <tr data-search={searchText} data-time={sortDate?.getTime() ?? 0} data-target={(observation.target ?? post.data.title).toLocaleLowerCase('ko-KR')}>
                  <td data-label="관측일">{formatDate(observation.observedAt ?? post.data.publishedAt)}</td>
                  <td data-label="대상"><strong>{observation.target ?? post.data.title}</strong><small>{post.data.title}</small></td>
                  <td data-label="장비">{observation.equipment.length ? observation.equipment.join(' · ') : '—'}</td>
                  <td data-label="시상 / 투명도">{observation.seeing ?? '—'} <span>/</span> {observation.transparency ?? '—'}</td>
                  <td data-label="기온 / 습도">{observation.temperatureC === undefined ? '—' : `${observation.temperatureC} °C`} <span>/</span> {observation.humidityPercent === undefined ? '—' : `${observation.humidityPercent}%`}</td>
                  <td data-label="자료"><a href={`/archive/${post.id}/`} aria-label={`${post.data.title} 원문 보기`}>원문 ↗</a><a href={`/archive/${post.id}/data.json`} download aria-label={`${post.data.title} 관측 데이터 JSON 다운로드`}>JSON ↓</a></td>
                </tr>;
              })}
            </tbody>
          </table>
        </div>
        <div class="observations-no-results" hidden><span aria-hidden="true">Ø</span><div><strong>일치하는 관측 기록이 없습니다.</strong><p>검색어를 줄이거나 다른 대상·장비 이름을 입력해 보세요.</p></div></div>
        </>
      ) : (
        <div class="observations-empty"><span aria-hidden="true">Ø</span><div><strong>아직 공개된 관측 데이터가 없습니다.</strong><p>관측 정보가 포함된 일지를 공개하면 이곳에 자동으로 집계됩니다.</p></div></div>
      )}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#observation-search');
  const sortSelect = document.querySelector<HTMLSelectElement>('#observation-sort');
  const tableWrap = document.querySelector<HTMLElement>('.observations-table-wrap');
  const tableBody = tableWrap?.querySelector<HTMLTableSectionElement>('tbody');
  const result = document.querySelector<HTMLElement>('.observations-result');
  const noResults = document.querySelector<HTMLElement>('.observations-no-results');
  const resetButton = document.querySelector<HTMLButtonElement>('.observations-reset');
  const rows = tableBody ? [...tableBody.querySelectorAll('tr')] : [];
  const allowedSorts = new Set(['newest', 'oldest', 'target']);

  const syncURL = () => {
    const url = new URL(window.location.href);
    const query = searchInput?.value.trim() ?? '';
    const order = sortSelect?.value ?? 'newest';
    query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
    order === 'newest' ? url.searchParams.delete('sort') : url.searchParams.set('sort', order);
    history.replaceState(null, '', `${url.pathname}${url.search}${url.hash}`);
  };

  const updateRecords = (updateURL = true) => {
    const query = searchInput?.value.trim().toLocaleLowerCase('ko-KR') ?? '';
    const order = sortSelect?.value ?? 'newest';
    const visibleRows = rows.filter((row) => row.dataset.search?.includes(query));

    visibleRows.sort((a, b) => {
      if (order === 'oldest') return Number(a.dataset.time) - Number(b.dataset.time);
      if (order === 'target') return (a.dataset.target ?? '').localeCompare(b.dataset.target ?? '', 'ko-KR');
      return Number(b.dataset.time) - Number(a.dataset.time);
    });

    rows.forEach((row) => { row.hidden = !visibleRows.includes(row); });
    visibleRows.forEach((row) => tableBody?.append(row));
    if (result) result.innerHTML = `<strong>${visibleRows.length}</strong>개 기록`;
    if (tableWrap) tableWrap.hidden = visibleRows.length === 0;
    if (noResults) noResults.hidden = visibleRows.length !== 0;
    if (resetButton) resetButton.hidden = query.length === 0 && order === 'newest';
    if (updateURL) syncURL();
  };

  searchInput?.addEventListener('input', () => updateRecords());
  sortSelect?.addEventListener('change', () => updateRecords());
  resetButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    if (sortSelect) sortSelect.value = 'newest';
    updateRecords();
    searchInput?.focus();
  });

  const restoreFromURL = () => {
    const params = new URLSearchParams(window.location.search);
    const requestedSort = params.get('sort') ?? 'newest';
    if (searchInput) searchInput.value = params.get('q') ?? '';
    if (sortSelect) sortSelect.value = allowedSorts.has(requestedSort) ? requestedSort : 'newest';
    updateRecords(false);
  };

  window.addEventListener('popstate', restoreFromURL);
  restoreFromURL();
</script>
