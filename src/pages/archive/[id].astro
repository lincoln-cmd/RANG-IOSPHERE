---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { byPublishedDate, categories, formatDate, hasObservationData, type PostEntry } from '../../lib/content';
import '../../styles/series.css';
import '../../styles/reading.css';
import '../../styles/sharing.css';
import 'katex/dist/katex.min.css';
import '../../styles/math.css';
import '../../styles/footnotes.css';
import '../../styles/tables.css';
import '../../styles/image-viewer.css';
import '../../styles/code-tools.css';
import '../../styles/print.css';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft && Boolean(data.publishedAt))).sort(byPublishedDate);
  return posts.map((post, index) => {
    const related = posts.filter((candidate) => candidate.id !== post.id && (candidate.data.category === post.data.category || candidate.data.tags.some((tag) => post.data.tags.includes(tag)))).slice(0, 3);
    const series = post.data.series ? posts.filter((candidate) => candidate.data.series === post.data.series).sort((a, b) => (a.data.publishedAt?.getTime() ?? 0) - (b.data.publishedAt?.getTime() ?? 0)) : [];
    return { params: { id: post.id }, props: { post, previous: posts[index + 1], next: posts[index - 1], related, series } };
  });
}

interface Props { post: PostEntry; previous?: PostEntry; next?: PostEntry; related: PostEntry[]; series: PostEntry[] }
const { post, previous, next, related, series } = Astro.props;
const { Content, headings } = await render(post);
const plainBody = (post.body ?? '').replace(/```[\s\S]*?```|<[^>]+>|[#>*_`\[\]()!-]/g, ' ');
const koreanCharacters = (plainBody.match(/[가-힣]/g) ?? []).length;
const otherWords = (plainBody.replace(/[가-힣]/g, ' ').match(/[\p{L}\p{N}]+/gu) ?? []).length;
const readingMinutes = Math.max(1, Math.ceil(koreanCharacters / 500 + otherWords / 200));
const category = categories[post.data.category];
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const observation = post.data.observation;
const showsObservation = hasObservationData(observation);
const observationFacts = observation ? [
  ['관측 대상', observation.target],
  ['관측 시각', observation.observedAt ? `${formatDate(observation.observedAt)} ${observation.observedAt.toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit', timeZone: 'Asia/Seoul' })}` : undefined],
  ['관측 장소', observation.location],
  ['시상', observation.seeing],
  ['투명도', observation.transparency],
  ['기온', observation.temperatureC === undefined ? undefined : `${observation.temperatureC} °C`],
  ['습도', observation.humidityPercent === undefined ? undefined : `${observation.humidityPercent}%`],
].filter((entry): entry is [string, string] => Boolean(entry[1])) : [];
const articleURL = new URL(`/archive/${post.id}/`, Astro.site ?? Astro.url).href;
const articleImage = post.data.cover ? new URL(post.data.cover, Astro.site ?? Astro.url).href : undefined;
const citation = `김동훈. (${formatDate(post.data.publishedAt)}). ${post.data.title}. 랑이오스페어. ${articleURL}`;
const articleStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  url: articleURL,
  mainEntityOfPage: articleURL,
  datePublished: post.data.publishedAt?.toISOString(),
  dateModified: (post.data.updatedAt ?? post.data.publishedAt)?.toISOString(),
  articleSection: category.label,
  keywords: post.data.tags.join(', '),
  inLanguage: 'ko-KR',
  timeRequired: `PT${readingMinutes}M`,
  image: articleImage,
  author: { '@type': 'Person', name: '김동훈' },
  publisher: { '@type': 'Person', name: '김동훈' },
};
const breadcrumbStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: new URL('/', Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 2, name: '아카이브', item: new URL('/archive/', Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: articleURL },
  ],
};
---
<BaseLayout title={`${post.data.title} | 랑이오스페어`} description={post.data.description} socialImage={post.data.cover ?? null} socialImageAlt={post.data.coverAlt ?? post.data.title} pageType="article" structuredData={[articleStructuredData, breadcrumbStructuredData]}>
  <SiteHeader compact />
  <main id="main-content" class="article-page" tabindex="-1">
    <div class="reading-progress" role="progressbar" aria-label="본문 읽기 진행률" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span></span></div>
    <button class="back-to-top" type="button" aria-label="페이지 맨 위로 이동" hidden><span aria-hidden="true">↑</span> TOP</button>
    <header class="article-hero">
      <a href="/archive/" class="back-link">← ARCHIVE</a>
      <p class="eyebrow">{category.index} · {category.en}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-meta"><span>{formatDate(post.data.publishedAt)}</span>{post.data.updatedAt && <span>수정 {formatDate(post.data.updatedAt)}</span>}<span>{category.label}</span><span>약 {readingMinutes}분</span></div>
      <div class="article-tags">{post.data.tags.map((tag) => <a href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
      <div class="article-actions" data-share-title={post.data.title} data-share-text={post.data.description} data-share-url={articleURL} data-citation={citation}>
        <button type="button" data-copy-link>링크 복사 <span aria-hidden="true">↗</span></button>
        <button type="button" data-copy-citation>인용 정보 복사 <span aria-hidden="true">↗</span></button>
        <button type="button" data-native-share hidden>공유 <span aria-hidden="true">↗</span></button>
        <button type="button" data-print-article>인쇄 · PDF <span aria-hidden="true">↗</span></button>
        <p role="status" aria-live="polite"></p>
      </div>
    </header>
    <span class="back-to-top-trigger" aria-hidden="true"></span>

    {post.data.cover && <figure class="article-cover"><img src={post.data.cover} alt={post.data.coverAlt ?? ''} loading="lazy" decoding="async" /><figcaption>{post.data.coverAlt}</figcaption></figure>}

    {post.data.series && series.length > 0 && <nav class="series-panel" aria-label={`${post.data.series} 연재`}><div><p>SERIES</p><h2>{post.data.series}</h2><span>{series.findIndex((entry) => entry.id === post.id) + 1} / {series.length}</span></div><ol>{series.map((entry, index) => <li class:list={{ current: entry.id === post.id }}><a href={`/archive/${entry.id}/`} aria-current={entry.id === post.id ? 'page' : undefined}><span>{String(index + 1).padStart(2, '0')}</span><strong>{entry.data.title}</strong></a></li>)}</ol><a href={`/archive/?series=${encodeURIComponent(post.data.series)}`}>연재 전체 보기 ↗</a></nav>}

    <div class="article-shell">
      <aside class="article-toc" aria-label="글 목차">
        <p>CONTENTS</p>
        {toc.length ? <ol>{toc.map((heading) => <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol> : <span>목차가 없습니다.</span>}
      </aside>
      <article class="prose">
        {observation && showsObservation && (
          <section class="observation-card" aria-labelledby="observation-data-title">
            <p>OBSERVATION DATA</p>
            <h2 id="observation-data-title">관측 정보</h2>
            {observationFacts.length > 0 && <dl>{observationFacts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
            {observation.equipment.length > 0 && <div class="observation-equipment"><strong>사용 장비</strong><p>{observation.equipment.join(' · ')}</p></div>}
            {observation.conditions && <div class="observation-conditions"><strong>관측 조건</strong><p>{observation.conditions}</p></div>}
            <a class="observation-download" href={`/archive/${post.id}/data.json`} download>관측 데이터 JSON <span aria-hidden="true">↓</span></a>
          </section>
        )}
        <Content />
        {post.data.references.length > 0 && (
          <section class="article-references" aria-labelledby="references-title">
            <p>REFERENCES</p>
            <h2 id="references-title">참고 자료</h2>
            <ol>{post.data.references.map((reference) => <li><a href={reference.url} target="_blank" rel="noreferrer"><strong>{reference.title}</strong><span>{reference.note ?? reference.url}</span><small>원문 열기 ↗</small></a></li>)}</ol>
          </section>
        )}
      </article>
    </div>

    <nav class="post-navigation" aria-label="이전 글과 다음 글">
      {previous ? <a href={`/archive/${previous.id}/`}><small>PREVIOUS</small><strong>{previous.data.title}</strong></a> : <span></span>}
      {next ? <a href={`/archive/${next.id}/`}><small>NEXT</small><strong>{next.data.title}</strong></a> : <span></span>}
    </nav>

    {related.length > 0 && <section class="related-posts"><p class="eyebrow">RELATED RECORDS</p><h2>함께 읽을 기록</h2><div>{related.map((entry) => <a href={`/archive/${entry.id}/`}><span>{categories[entry.data.category].label}</span><strong>{entry.data.title}</strong><p>{entry.data.description}</p></a>)}</div></section>}

    <dialog class="image-viewer" aria-label="게시물 이미지 확대 보기">
      <button type="button" data-viewer-close aria-label="이미지 확대 보기 닫기">닫기 <span aria-hidden="true">×</span></button>
      <figure><img src="" alt="" /><figcaption></figcaption></figure>
    </dialog>
  </main>
  <SiteFooter />
  <script is:inline>
    const progress = document.querySelector('.reading-progress');
    const article = document.querySelector('.prose');
    const backToTop = document.querySelector('.back-to-top');
    const backToTopTrigger = document.querySelector('.back-to-top-trigger');
    const tocLinks = [...document.querySelectorAll('.article-toc a[href^="#"]')];
    const tocHeadings = tocLinks.map((link) => {
      const href = link.getAttribute('href') || '';
      try { return document.getElementById(decodeURIComponent(href.slice(1))); } catch { return null; }
    });
    let scheduled = false;
    const updateBackToTop = () => {
      if (!backToTop || !backToTopTrigger) return;
      backToTop.hidden = backToTopTrigger.getBoundingClientRect().top >= 0;
    };
    const updateActiveHeading = () => {
      let activeIndex = -1;
      tocHeadings.forEach((heading, index) => { if (heading && heading.getBoundingClientRect().top <= 160) activeIndex = index; });
      tocLinks.forEach((link, index) => {
        if (index === activeIndex) link.setAttribute('aria-current', 'location'); else link.removeAttribute('aria-current');
      });
    };
    const updateReadingProgress = () => {
      scheduled = false;
      if (!progress || !article) return;
      const start = article.getBoundingClientRect().top + window.scrollY - 120;
      const end = start + article.offsetHeight - window.innerHeight * .5;
      const value = Math.round(Math.min(100, Math.max(0, ((window.scrollY - start) / Math.max(1, end - start)) * 100)));
      progress.style.setProperty('--reading-progress', `${value}%`);
      progress.setAttribute('aria-valuenow', String(value));
      updateBackToTop();
      updateActiveHeading();
    };
    const requestProgressUpdate = () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(updateReadingProgress);
    };
    addEventListener('scroll', requestProgressUpdate, { passive: true });
    addEventListener('resize', requestProgressUpdate);
    document.addEventListener('scroll', requestProgressUpdate, { passive: true });
    window.visualViewport?.addEventListener('scroll', requestProgressUpdate, { passive: true });
    window.visualViewport?.addEventListener('resize', requestProgressUpdate);
    addEventListener('pageshow', () => {
      requestProgressUpdate();
      requestAnimationFrame(requestProgressUpdate);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') requestProgressUpdate();
    });
    tocLinks.forEach((link) => link.addEventListener('click', () => {
      tocLinks.forEach((item) => item.removeAttribute('aria-current'));
      link.setAttribute('aria-current', 'location');
    }));
    updateReadingProgress();
    requestAnimationFrame(requestProgressUpdate);
    if (backToTopTrigger && 'IntersectionObserver' in window) {
      new IntersectionObserver(updateBackToTop).observe(backToTopTrigger);
    }
    backToTop?.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });

    const actions = document.querySelector('.article-actions');
    const copyButton = actions?.querySelector('[data-copy-link]');
    const citationButton = actions?.querySelector('[data-copy-citation]');
    const shareButton = actions?.querySelector('[data-native-share]');
    const printButton = actions?.querySelector('[data-print-article]');
    const shareStatus = actions?.querySelector('[role="status"]');
    const shareURL = actions?.dataset.shareUrl || window.location.href;
    const setShareStatus = (message) => {
      if (shareStatus) shareStatus.textContent = message;
    };
    copyButton?.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(shareURL);
        setShareStatus('게시물 링크를 복사했습니다.');
      } catch { setShareStatus('링크를 복사하지 못했습니다. 주소창에서 직접 복사해 주세요.'); }
    });
    citationButton?.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard?.writeText || !actions?.dataset.citation) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(actions.dataset.citation);
        setShareStatus('인용 정보를 복사했습니다.');
      } catch { setShareStatus('인용 정보를 복사하지 못했습니다.'); }
    });
    if (shareButton && navigator.share) {
      shareButton.hidden = false;
      shareButton.addEventListener('click', async () => {
        try {
          await navigator.share({ title: actions?.dataset.shareTitle, text: actions?.dataset.shareText, url: shareURL });
          setShareStatus('공유 메뉴를 열었습니다.');
        } catch (error) {
          if (error?.name !== 'AbortError') setShareStatus('공유 메뉴를 열지 못했습니다. 링크 복사를 이용해 주세요.');
        }
      });
    }
    printButton?.addEventListener('click', () => window.print());

    const chemistryText = (formula) => {
      const math = formula.querySelector('.katex-mathml math');
      const expression = math?.querySelector('semantics > :first-child');
      if (!expression) return '';
      const cleanExpression = expression.cloneNode(true);
      if (!(cleanExpression instanceof Element)) return '';
      cleanExpression.querySelectorAll('mphantom').forEach((node) => node.remove());
      return (cleanExpression.textContent || '').replaceAll('\u200b', '').trim();
    };
    document.addEventListener('copy', (event) => {
      const selection = window.getSelection();
      if (!selection || selection.isCollapsed || !event.clipboardData) return;
      const range = selection.getRangeAt(0).cloneRange();
      const closestFormula = (node) => (node instanceof Element ? node : node.parentElement)?.closest('.katex');
      const startFormula = closestFormula(range.startContainer);
      const endFormula = closestFormula(range.endContainer);
      if (startFormula) range.setStartBefore(startFormula);
      if (endFormula) range.setEndAfter(endFormula);
      const fragment = range.cloneContents();
      const chemistryFormulas = [...fragment.querySelectorAll('.katex')].filter((formula) =>
        formula.querySelector('annotation')?.textContent?.trim().startsWith('\\ce{'),
      );
      if (!chemistryFormulas.length) return;
      chemistryFormulas.forEach((formula) => formula.replaceWith(document.createTextNode(chemistryText(formula))));
      event.clipboardData.setData('text/plain', (fragment.textContent || '').replaceAll('\u200b', ''));
      event.preventDefault();
    });

    const imageViewer = document.querySelector('dialog.image-viewer');
    const viewerImage = imageViewer?.querySelector('img');
    const viewerCaption = imageViewer?.querySelector('figcaption');
    const closeViewerButton = imageViewer?.querySelector('[data-viewer-close]');
    const viewableImages = [...document.querySelectorAll('.article-cover img, .prose img')].filter((image) => image instanceof HTMLImageElement);
    const openImageViewer = (image) => {
      if (!imageViewer || !viewerImage || !(image instanceof HTMLImageElement)) return;
      if (typeof imageViewer.showModal !== 'function') { window.open(image.currentSrc || image.src, '_blank', 'noopener'); return; }
      viewerImage.src = image.currentSrc || image.src;
      viewerImage.alt = image.alt;
      if (viewerCaption) { viewerCaption.textContent = image.alt; viewerCaption.hidden = !image.alt; }
      imageViewer.showModal();
    };
    viewableImages.forEach((image) => {
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', `${image.alt || '게시물 이미지'} 확대 보기`);
      image.addEventListener('click', () => openImageViewer(image));
      image.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openImageViewer(image); } });
    });
    closeViewerButton?.addEventListener('click', () => imageViewer?.close());
    imageViewer?.addEventListener('click', (event) => { if (event.target === imageViewer) imageViewer.close(); });
    imageViewer?.addEventListener('close', () => { if (viewerImage) viewerImage.src = ''; });

    const codeBlocks = [...document.querySelectorAll('.prose pre')];
    codeBlocks.forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const languageClass = [...code.classList].find((className) => className.startsWith('language-'));
      const language = pre.dataset.language || (languageClass ? languageClass.slice('language-'.length) : 'code');
      const toolbar = document.createElement('div');
      toolbar.className = 'code-toolbar';
      const label = document.createElement('span');
      label.textContent = language;
      const copyCodeButton = document.createElement('button');
      copyCodeButton.type = 'button';
      copyCodeButton.textContent = '복사';
      copyCodeButton.setAttribute('aria-label', `${language} 코드 복사`);
      toolbar.append(label, copyCodeButton);
      pre.before(toolbar);
      pre.dataset.enhanced = 'true';
      copyCodeButton.addEventListener('click', async () => {
        try {
          if (!navigator.clipboard?.writeText) throw new Error('clipboard unavailable');
          await navigator.clipboard.writeText(code.textContent || '');
          copyCodeButton.textContent = '복사됨';
          copyCodeButton.setAttribute('aria-label', `${language} 코드가 복사되었습니다`);
          setTimeout(() => {
            copyCodeButton.textContent = '복사';
            copyCodeButton.setAttribute('aria-label', `${language} 코드 복사`);
          }, 1800);
        } catch {
          copyCodeButton.textContent = '복사 실패';
          copyCodeButton.setAttribute('aria-label', '코드를 복사하지 못했습니다');
        }
      });
    });
  </script>
</BaseLayout>
