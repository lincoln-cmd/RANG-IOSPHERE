---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { byPublishedDate, categories, formatDate } from '../../lib/content';
import '../../styles/series.css';

const posts = (await getCollection('posts', ({ data }) => !data.draft && Boolean(data.publishedAt))).sort(byPublishedDate);
---
<BaseLayout title="아카이브 | 랑이오스페어" description="랑이오스페어의 관측일지와 천체관측 탐구 기록">
  <SiteHeader compact />
  <main class="archive-page">
    <header class="archive-intro">
      <p class="eyebrow">FIELD NOTES & RESEARCH ARCHIVE</p>
      <h1>관측과 탐구의 기록</h1>
      <p>직접 관측하고 공부한 내용을 다섯 영역으로 나누어 정리합니다. 초안은 공개하지 않으며, 확인을 마친 기록만 이곳에 표시됩니다.</p>
      <dl><div><dt>PUBLIC RECORDS</dt><dd>{String(posts.length).padStart(2, '0')}</dd></div><div><dt>SECTORS</dt><dd>05</dd></div><div><dt>STATUS</dt><dd>BUILDING</dd></div></dl>
    </header>

    <nav class="archive-index" aria-label="아카이브 분류">
      {Object.entries(categories).map(([key, category]) => (
        <a href={`#${key}`}><span>{category.index}</span>{category.label}<small>{category.en}</small></a>
      ))}
    </nav>

    <section class="archive-tools" aria-labelledby="archive-search-title">
      <div class="archive-search">
        <label id="archive-search-title" for="archive-query">기록 검색</label>
        <div>
          <span aria-hidden="true">⌕</span>
          <input id="archive-query" type="search" placeholder="제목, 설명, 태그 검색" autocomplete="off" />
        </div>
      </div>
      <div class="archive-filters" aria-label="기록 분류 필터">
        <button type="button" data-category-filter="all" aria-pressed="true">전체</button>
        {Object.entries(categories).map(([key, category]) => (
          <button type="button" data-category-filter={key} aria-pressed="false">{category.label}</button>
        ))}
      </div>
      <div class="archive-sort">
        <label for="archive-sort">정렬</label>
        <select id="archive-sort">
          <option value="newest">최신순</option>
          <option value="oldest">오래된순</option>
        </select>
      </div>
      <div class="archive-result-wrap"><p class="archive-result" aria-live="polite"><strong>{posts.length}</strong>개의 공개 기록</p><button class="archive-clear" type="button" hidden>필터 초기화</button></div>
    </section>

    <div class="archive-sections">
      {Object.entries(categories).map(([key, category]) => {
        const categoryPosts = posts.filter((post) => post.data.category === key);
        return (
          <section class="archive-group" id={key} data-category={key}>
            <header><span>{category.index}</span><div><p>{category.en}</p><h2>{category.label}</h2></div><strong data-group-count>{String(categoryPosts.length).padStart(2, '0')}</strong></header>
            {categoryPosts.length ? (
              <div class="post-list">
                {categoryPosts.map((post) => (
                  <article data-archive-post data-published={post.data.publishedAt?.getTime() ?? 0} data-search={`${post.data.title} ${post.data.description} ${post.data.series ?? ''} ${post.data.tags.join(' ')}`.toLocaleLowerCase('ko')} data-tags={post.data.tags.map((tag) => tag.toLocaleLowerCase('ko')).join('|')} data-series={(post.data.series ?? '').toLocaleLowerCase('ko')}>
                    {post.data.cover && <a class="post-cover" href={`/archive/${post.id}/`} tabindex="-1" aria-hidden="true"><img src={post.data.cover} alt="" loading="lazy" decoding="async" /></a>}
                    <p>{formatDate(post.data.publishedAt)}</p>
                    <h3><a href={`/archive/${post.id}/`}>{post.data.title}</a></h3>
                    <p>{post.data.description}</p>
                    {post.data.series && <a class="post-series" href={`/archive/?series=${encodeURIComponent(post.data.series)}`}>SERIES · {post.data.series}</a>}
                    <div>{post.data.tags.map((tag) => <a href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
                    <a href={`/archive/${post.id}/`} aria-label={`${post.data.title} 읽기`}>READ NOTE ↗</a>
                  </article>
                ))}
              </div>
            ) : (
              <div class="empty-record"><span aria-hidden="true">＋</span><div><strong>아직 공개된 기록이 없습니다.</strong><p>직접 관측하고 공부한 내용을 정리한 뒤 첫 기록을 공개할 예정입니다.</p></div></div>
            )}
          </section>
        );
      })}
      <div class="archive-no-results" hidden>
        <span aria-hidden="true">Ø</span>
        <div><strong>조건에 맞는 기록이 없습니다.</strong><p>검색어를 바꾸거나 다른 분류를 선택해 보세요.</p></div>
      </div>
    </div>
  </main>
  <SiteFooter />

  <script is:inline>
    const queryInput = document.querySelector('#archive-query');
    const sortSelect = document.querySelector('#archive-sort');
    const filterButtons = [...document.querySelectorAll('[data-category-filter]')];
    const groups = [...document.querySelectorAll('[data-category]')];
    const result = document.querySelector('.archive-result');
    const clearButton = document.querySelector('.archive-clear');
    const noResults = document.querySelector('.archive-no-results');
    let selectedCategory = 'all';
    let selectedTag = '';
    let selectedSeries = '';
    let selectedSort = 'newest';

    const normalize = (value) => value.trim().toLocaleLowerCase('ko');
    const allowedCategories = filterButtons.map((item) => item.dataset.categoryFilter);
    const readURLState = () => {
      const params = new URLSearchParams(window.location.search);
      const category = params.get('category') || 'all';
      selectedCategory = allowedCategories.includes(category) ? category : 'all';
      selectedTag = normalize(params.get('tag') || '');
      selectedSeries = normalize(params.get('series') || '');
      selectedSort = params.get('sort') === 'oldest' ? 'oldest' : 'newest';
      if (queryInput) queryInput.value = params.get('q') || '';
      if (sortSelect) sortSelect.value = selectedSort;
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.categoryFilter === selectedCategory)));
    };
    const writeURLState = (mode = 'replace') => {
      const params = new URLSearchParams();
      const query = queryInput?.value.trim() || '';
      if (query) params.set('q', query);
      if (selectedTag) params.set('tag', selectedTag);
      if (selectedSeries) params.set('series', selectedSeries);
      if (selectedCategory !== 'all') params.set('category', selectedCategory);
      if (selectedSort === 'oldest') params.set('sort', selectedSort);
      const url = `${window.location.pathname}${params.size ? `?${params}` : ''}${window.location.hash}`;
      window.history[mode === 'push' ? 'pushState' : 'replaceState']({}, '', url);
    };
    const applyArchiveFilters = () => {
      const query = normalize(queryInput?.value ?? '');
      let visibleTotal = 0;

      groups.forEach((group) => {
        const categoryMatches = selectedCategory === 'all' || group.dataset.category === selectedCategory;
        const posts = [...group.querySelectorAll('[data-archive-post]')];
        const postList = group.querySelector('.post-list');
        posts.sort((a, b) => {
          const difference = Number(b.dataset.published || 0) - Number(a.dataset.published || 0);
          return selectedSort === 'oldest' ? -difference : difference;
        });
        if (postList) posts.forEach((post) => postList.append(post));
        let visibleInGroup = 0;

        posts.forEach((post) => {
          const queryMatches = !query || post.dataset.search.includes(query);
          const tagMatches = !selectedTag || (post.dataset.tags || '').split('|').includes(selectedTag);
          const seriesMatches = !selectedSeries || post.dataset.series === selectedSeries;
          const visible = categoryMatches && queryMatches && tagMatches && seriesMatches;
          post.hidden = !visible;
          if (visible) visibleInGroup += 1;
        });

        const keepEmptyCategory = categoryMatches && !query && !selectedTag && !selectedSeries && posts.length === 0;
        group.hidden = !(visibleInGroup > 0 || keepEmptyCategory);
        const count = group.querySelector('[data-group-count]');
        if (count) count.textContent = String(visibleInGroup).padStart(2, '0');
        visibleTotal += visibleInGroup;
      });

      if (result) {
        result.replaceChildren();
        if (selectedTag) { const tag = document.createElement('span'); tag.textContent = `#${selectedTag}`; result.append(tag, ' · '); }
        if (selectedSeries) { const series = document.createElement('span'); series.textContent = selectedSeries; result.append(series, ' 연재 · '); }
        const count = document.createElement('strong'); count.textContent = String(visibleTotal); result.append(count, '개의 공개 기록');
      }
      if (clearButton) clearButton.hidden = !query && !selectedTag && !selectedSeries && selectedCategory === 'all' && selectedSort === 'newest';
      if (noResults) noResults.hidden = (!query && !selectedTag && !selectedSeries) || visibleTotal > 0;
    };

    queryInput?.addEventListener('input', () => { selectedTag = ''; selectedSeries = ''; writeURLState(); applyArchiveFilters(); });
    sortSelect?.addEventListener('change', () => { selectedSort = sortSelect.value === 'oldest' ? 'oldest' : 'newest'; writeURLState('push'); applyArchiveFilters(); });
    filterButtons.forEach((button) => button.addEventListener('click', () => {
      selectedCategory = button.dataset.categoryFilter;
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      writeURLState('push');
      applyArchiveFilters();
    }));
    clearButton?.addEventListener('click', () => {
      selectedCategory = 'all'; selectedTag = ''; selectedSeries = ''; selectedSort = 'newest'; if (queryInput) queryInput.value = ''; if (sortSelect) sortSelect.value = selectedSort;
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.categoryFilter === 'all')));
      writeURLState('push'); applyArchiveFilters();
    });
    window.addEventListener('popstate', () => { readURLState(); applyArchiveFilters(); });
    readURLState();
    applyArchiveFilters();
  </script>
</BaseLayout>
