---
import '../styles/global.css';
import '../styles/app-update.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
  socialImageAlt?: string;
  pageType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = '랑이오스페어 | RANG-IOSPHERE',
  description = '관측하고, 비교하고, 기록하는 개인 천체관측 아카이브',
  socialImage = '/og.png',
  socialImageAlt = '랑이오스페어 개인 천체관측 아카이브',
  pageType = 'website',
  structuredData,
} = Astro.props;
const resolvedSocialImage = socialImage ? new URL(socialImage, Astro.site ?? Astro.url) : null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const rssURL = new URL('/rss.xml', Astro.site ?? Astro.url);
const serializedStructuredData = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION?.trim();
const naverSiteVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION?.trim();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {naverSiteVerification && <meta name="naver-site-verification" content={naverSiteVerification} />}
    <meta name="theme-color" content="#060914" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="랑이오스페어" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="랑이오스페어 RSS" href={rssURL} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="랑이오스페어" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">본문 바로가기</a>
    <slot />
    <aside class="app-update" hidden role="status" aria-live="polite">
      <div>
        <strong>새 버전이 준비되었습니다.</strong>
        <span>최신 기록과 기능을 바로 적용할 수 있습니다.</span>
      </div>
      <button type="button">업데이트</button>
    </aside>
    <script>
      if ('serviceWorker' in navigator && !window.location.pathname.startsWith('/admin')) {
        window.addEventListener('load', async () => {
          const registration = await navigator.serviceWorker.register('/sw.js').catch(() => null);
          if (!registration) return;

          const notice = document.querySelector<HTMLElement>('.app-update');
          const button = notice?.querySelector<HTMLButtonElement>('button');
          let refreshing = false;

          const showNotice = () => {
            if (notice) notice.hidden = false;
          };

          if (registration.waiting && navigator.serviceWorker.controller) showNotice();

          registration.addEventListener('updatefound', () => {
            const worker = registration.installing;
            worker?.addEventListener('statechange', () => {
              if (worker.state === 'installed' && navigator.serviceWorker.controller) showNotice();
            });
          });

          button?.addEventListener('click', () => {
            if (!registration.waiting) return;
            refreshing = true;
            button.disabled = true;
            button.textContent = '적용 중…';
            registration.waiting.postMessage({ type: 'SKIP_WAITING' });
          });

          navigator.serviceWorker.addEventListener('controllerchange', () => {
            if (refreshing) window.location.reload();
          });

          window.setInterval(() => registration.update().catch(() => {}), 60 * 60 * 1000);
        });
      }
    </script>
  </body>
</html>
