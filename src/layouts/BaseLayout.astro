---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
}

const {
  title = '랑이오스페어 | RANG-IOSPHERE',
  description = '관측하고, 비교하고, 기록하는 개인 천체관측 아카이브',
  socialImage = '/og.png',
} = Astro.props;
const resolvedSocialImage = socialImage ? new URL(socialImage, Astro.site ?? Astro.url) : null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const rssURL = new URL('/rss.xml', Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060914" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="랑이오스페어 RSS" href={rssURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
