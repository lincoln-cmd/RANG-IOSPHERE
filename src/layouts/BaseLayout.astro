---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string | null;
  socialImageAlt?: string;
  pageType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = '랑이오스페어 | RANG-IOSPHERE',
  description = '관측하고, 비교하고, 기록하는 개인 천체관측 아카이브',
  socialImage = '/og.png',
  socialImageAlt = '랑이오스페어 개인 천체관측 아카이브',
  pageType = 'website',
  structuredData,
} = Astro.props;
const resolvedSocialImage = socialImage ? new URL(socialImage, Astro.site ?? Astro.url) : null;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const rssURL = new URL('/rss.xml', Astro.site ?? Astro.url);
const serializedStructuredData = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : null;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#060914" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="랑이오스페어" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="랑이오스페어 RSS" href={rssURL} />
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {resolvedSocialImage && <meta property="og:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedSocialImage && <meta name="twitter:image" content={resolvedSocialImage} />}
    {resolvedSocialImage && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {serializedStructuredData && <script is:inline type="application/ld+json" set:html={serializedStructuredData} />}
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator && !window.location.pathname.startsWith('/admin')) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
  </body>
</html>
