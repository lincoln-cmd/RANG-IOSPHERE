{
  "name": "rang-iosphere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm validate:content && pnpm check && pnpm build:site",
    "build:site": "astro build && node scripts/write-build-info.mjs && pnpm validate:links",
    "preview": "astro preview",
    "check": "astro check",
    "new:post": "node scripts/new-post.mjs",
    "backup:verified": "node scripts/backup-verified.mjs",
    "smoke:test": "node scripts/smoke-test.mjs",
    "validate:links": "node scripts/validate-build-links.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "prepublish:check": "pnpm validate:content --strict && pnpm check && pnpm build:site"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^6.4.8",
    "katex": "^0.18.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.3",
    "yaml": "^2.9.0"
  }
}
